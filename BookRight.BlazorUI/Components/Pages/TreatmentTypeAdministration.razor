@page "/behandlingstype"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BookRight.Facade.Interfaces.TreatmentTypeUseCase
@using BookRight.Facade.Interfaces.TreatmentTypesUseCase
@using BookRight.Facade.DTOs.CreateTreatmentTypeDTOs
@using BookRight.Facade.Interfaces
@inject ICreateTreatmentTypeUseCase CreateTreatmentTypeUseCase
@inject IGetAllTreatmentTypesUseCase GetAllTreatmentTypesUseCase
@inject IGetAllTherapistsUseCase GetAllTherapistsUseCase


<PageTitle>Behandlingstype</PageTitle>

<main class="container mt-4">
    <h3 class="ms-3">Administrer behandlinger</h3>
    <article class="card mb-4">
        <fieldset class="card-body p-4">
            <h4 class="ms-3 mt-3">Opret ny behandlingstype</h4>
            <div class="mb-3">
                <label class="form-label">Behandling</label>
                <input class="form-control" @bind="_treatmentTypeName" placeholder="Skriv ind navn på behandling her..." />
                <label class="form-label">Varighed</label>
                <input class="form-control" type="number" @bind="_treatmentTypeDuration" min="1" placeholder="Skriv ind varighed her..." />
                <label class="form-label">Andtal deltagere</label>
                <input class="form-control" type="number" @bind="_maxParticipants" min="1" placeholder="Skriv ind max andtal personer her..." />
                <label class="form-label">Pris</label>
                <input class="form-control" type="number" @bind="_price" min="0" placeholder="Skriv ind pris her..." />
                <label class="form-label" >Kan kombineres</label>
                <select class ="form-select" @bind="_canBeCombinedString">
                    <option value="false" >Nej</option>
                    <option value="true" >Ja</option>
                </select>

                <label class="form-label">Autorisation</label>

                    <select class="form-select" @bind="_RequiredSpecialization">
                    <option value="">Vælg påkrevd autorisation</option>
                    @foreach (var authorization in _authorizationTypes)
                {
                    <option value="@authorization">
                        @authorization
                    </option>
                        @if (!string.IsNullOrEmpty(treatmentCreateMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                @treatmentCreateMessage
                            </div>
                        }
                }
                </select>

                <button class="button btn-primary mt-4 rounded-1" @onclick="HandleCreateTreatmentType">Opret Behandlingstype</button>
                    @if (!string.IsNullOrEmpty(treatmentCreateMessage))
                {
                    <div class="alert alert-danger mt-3">
                        @treatmentCreateMessage
                    </div>
                }
            
            </div>
        </fieldset>
    </article>
</main>

@code {

    private string _treatmentTypeName = "";
    private int _treatmentTypeDuration;
    private int _maxParticipants;
    private decimal _price;
    private string _canBeCombinedString = "false"; //gemmer input som text, siden select arbejder med string
    private bool _canBeCombined => _canBeCombinedString == "true"; //convertere string til bool for usecase
    private string? _RequiredSpecialization;
    private string treatmentCreateMessage = "";
    private List<string> _authorizationTypes = [];
    private string _therapistSpecialization = "";



    private async Task HandleCreateTreatmentType()
    {
        if (string.IsNullOrEmpty(_treatmentTypeName))
        {
            treatmentCreateMessage = "Navn skal være udfyldt";
            return;
        }
        try
        {
            var request = new CreateTreatmentTypeRequest
            {
                Name = _treatmentTypeName,
                DurationMinutes = _treatmentTypeDuration,
                MaxParticipants = _maxParticipants,
                Price = _price,
                CanBeCombined = _canBeCombined,
                RequiredSpecialization = _RequiredSpecialization
                
            };
            var response = await CreateTreatmentTypeUseCase.ExecuteAsync(request);
            treatmentCreateMessage = "Behandlingstype oprettet!";
        }
        catch(ArgumentException ex)
        {
            treatmentCreateMessage = ex.Message;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    private async Task LoadData()
    {
        var therapists = await GetAllTherapistsUseCase.ExecuteAsync();
        _authorizationTypes = therapists
            .Select(t => t.AuthorizationType)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
    }

}

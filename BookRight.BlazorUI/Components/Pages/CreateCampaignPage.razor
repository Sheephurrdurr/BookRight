@page "/opret-kampagne"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ICreateCampaignDiscountUseCase CreateCampaignDiscountUseCase

@using BookRight.BlazorUI.Components.Campaign
@using BookRight.Facade.DTOs.CreateCampaignDTOs
@using BookRight.Facade.Interfaces.DiscountUseCases

<PageTitle>Opret Kampagne</PageTitle>
<h2>Opret Kampagne</h2>

@if (_error is not null)
{
	<p class="text-danger">@_error</p>
}

else if (_loading)
{
	<p>Indlæser...</p>
}

else
{
	<CreateCampaignForm Model="@_model"
						OnValidSubmit="HandleSubmit" />
	@if (_statusMessage is not null)
	{
		<p>@_statusMessage</p>
	}
}

@code {
	private readonly CreateCampaignInputModel _model = new();
	private string? _error;
	private string? _statusMessage;
	private bool _loading = false;

	private async Task HandleSubmit()
	{
		_statusMessage = null;
		_error = null;

		try
		{
			await CreateCampaignDiscountUseCase.ExecuteAsync(new CreateCampaignDiscountRequest
			{
				Name = _model.Name,
				DiscountPercent = _model.DiscountPercent,
				StartDate = _model.StartDate,
				EndDate = _model.EndDate,
				TreatmentTypeIds = new()
			});

			_model.Name = string.Empty;
			_model.DiscountPercent = 0;

			_statusMessage = "Kampagne oprettet!";
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}

	}
}
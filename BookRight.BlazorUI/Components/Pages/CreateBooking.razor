@page "/opret-booking"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BookRight.BlazorUI.Components.Booking
@using BookRight.Facade.Interfaces
@using BookRight.Facade.Interfaces.ClinicsUseCases
@using BookRight.Facade.Interfaces.TherapistUseCases
@using BookRight.Facade.Interfaces.BookingUseCases
@using BookRight.Facade.Interfaces.DiscountUseCases
@using BookRight.Facade.DTOs.GetAllCustomersDTOs
@using BookRight.Facade.DTOs.GetAllClinicsDTOs
@using BookRight.Facade.DTOs.GetAllTherapistsDTOs
@using BookRight.Facade.DTOs.GetAllTherapistTreatmentTypesDTOs
@using BookRight.Facade.DTOs.CreateBookingDTOs
@using BookRight.Facade.DTOs.GetGroupSlotAvailabilityDTOs
@using BookRight.Facade.DTOs.GetAllCampaignDiscountsDTOs
@using BookRight.Facade.DTOs.ValueObjectDTOs
@inject IGetAllCustomersUseCase GetAllCustomersUseCase
@inject IGetAllClinicsUseCase GetAllClinicsUseCase
@inject ICreateBookingUseCase CreateBookingUseCase
@inject IGetAllTherapistsUseCase GetAllTherapistsUseCase
@inject IGetAllTherapistTreatmentTypesUseCase GetAllTherapistTreatmentTypesUseCase
@inject IGetGroupSlotAvailabilityUseCase GetGroupSlotAvailabilityUseCase
@inject IGetAllCampaignDiscountsUseCase GetAllCampaignDiscountsUseCase


<PageTitle>Opret Booking</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Opret Booking</h1>
    
    <article class="row">
        <section class="col-md-6">
            <div class="card">

                <div class="card-body">
                    <h4 class="mb-0">Ny Booking</h4>
                
                <div class="card-body">

                   <CustomerSelector
                       Customers ="customers"
                       @bind-SelectedCustomerId="selectedCustomerId"/>

                    <ClinicSelector
                        Clinics="clinics"
                        @bind-SelectedClinicId="selectedClinicId"/>

                    <TreatmentTypeSelector 
                        FilteredTreatmentTypes="uniqueTreatmentTypes"
                        @bind-SelectedTreatmentTypeId="selectedTreatmentTypeId"
                        OnTreatmentTypeSelected="HandleTreatmentTypeSelected"/>

                    <TherapistSelector 
                        Therapists="filteredTherapists"
                        @bind-SelectedTherapistId="selectedTherapistId" />


         

                  <CampaignSelector 
                      CampaignDiscounts="campaignDiscounts"
                      @bind-SelectedCampaignDiscountId="selectedCampaignDiscountId"/>

                   <SlotPicker
                       StartTime="startTime"
                       StartTimeChanged="t => startTime = t" 
                       RemainingSlots="remainingSlots"
                       IsFullyBooked="isFullyBooked"
                       OnSlotChanged="HandleSlotChanged"/>

                    <button class="btn btn-primary mt-4" @onclick="HandleCreateBooking">Opret Booking</button>

					@if (!string.IsNullOrEmpty(bookingMessage))
					{
						<div class="@bookingAlertClass mt-3">
							@bookingMessage
						</div>
					}
                 
                    </div>
                </div>
            </div>
      
        </section>
        <section class="col-md-6">
            <div class="br-summary-aside">
                <BookingSummary Response="finalResponse" />
            </div>

        </section>
    </article>
</div>

@code {
    private string selectedCustomerId = "";
    private string selectedClinicId = "";
    private string selectedTreatmentTypeId = "";
    private string selectedTherapistId = "";
    private string selectedCampaignDiscountId = "";
    private DateTime startTime = DateTime.Now;

    private string bookingMessage = "";
    private string bookingAlertClass = "";

    private int? remainingSlots = null;
    private bool isFullyBooked = false;

    private IReadOnlyList<GetAllCustomersResponse> customers = new List<GetAllCustomersResponse>();
    private IReadOnlyList<GetAllClinicsResponse> clinics = new List<GetAllClinicsResponse>();
    private IReadOnlyList<GetAllTherapistsResponse> therapists = new List<GetAllTherapistsResponse>();
    private IReadOnlyList<GetAllCampaignDiscountsResponse> campaignDiscounts = new List<GetAllCampaignDiscountsResponse>();
    private IReadOnlyList<GetAllTherapistTreatmentTypesResponse> allTherapistTreatmentTypes = new List<GetAllTherapistTreatmentTypesResponse>();

    private IReadOnlyList<GetAllTherapistTreatmentTypesResponse> uniqueTreatmentTypes = [];
    private IReadOnlyList<GetAllTherapistsResponse> filteredTherapists = new List<GetAllTherapistsResponse>();

    private CreateBookingResponse? finalResponse = null;

    protected override async Task OnInitializedAsync()
    {
        customers = await GetAllCustomersUseCase.ExecuteAsync();
        clinics = await GetAllClinicsUseCase.ExecuteAsync();
        therapists = await GetAllTherapistsUseCase.ExecuteAsync();
        campaignDiscounts = await GetAllCampaignDiscountsUseCase.ExecuteAsync();
        allTherapistTreatmentTypes = await GetAllTherapistTreatmentTypesUseCase.ExecuteAsync();

        // How do we get uniqueTreatmentTypes?
        uniqueTreatmentTypes = allTherapistTreatmentTypes 
            .GroupBy(ttt => ttt.TreatmentTypeName) // Group the new selection by TreatmentType name
            .Select(g => g.First()) // Just get the first (element)
            .OrderBy(ttt => ttt.TreatmentTypeName) // Sort them all on the name, so it looks neat in the list
            .ToList(); // throw it into that neat looking list
    }

    private void HandleTreatmentTypeSelected(string treatmentTypeId)
    {
        // Only keep therapists, that has a related TherapistTreatmentType(null or empty)
        // It also has to fulfill the two requirements (.any()): 
        // TherapistTreatmentType belongs to the selected therapist
        // && TherapistTreatmentType is the selected treatmentType
        filteredTherapists = string.IsNullOrEmpty(treatmentTypeId)
            ? []
            : therapists
                .Where(t => allTherapistTreatmentTypes
                .Any(ttt => ttt.TherapistId == t.Id && ttt.Id.ToString() == treatmentTypeId))
                .OrderBy(t => t.LastName)
                .ThenBy(t => t.FirstName)
                .ToList();

    }

    // Method is run when either the time slot or the treatment type changes, to check availability for the selected slot and treatment
    public async Task HandleSlotChanged()
    {
        if (string.IsNullOrEmpty(selectedTreatmentTypeId) || startTime == default)
        {
            remainingSlots = null;
            return;
        }

        var therapistTreatmentType = allTherapistTreatmentTypes
            .FirstOrDefault(t => t.Id.ToString() == selectedTreatmentTypeId);
        if (therapistTreatmentType is null) 
            return;

        var request = new GetGroupSlotAvailabilityRequest
		{

            TherapistTreatmentTypeId = therapistTreatmentType.Id,
            TimeSlot = new TimeSlotDto { StartTime = startTime, EndTime = startTime.AddMinutes(therapistTreatmentType?.DurationMinutes ?? 0) }
		};

        var response = await GetGroupSlotAvailabilityUseCase.ExecuteAsync(request);
        remainingSlots = response.RemainingSlots;
        isFullyBooked = response.IsFullyBooked;
    }

    private async Task HandleCreateBooking()
    {

        if (string.IsNullOrEmpty(selectedCustomerId) ||
            string.IsNullOrEmpty(selectedTherapistId) ||
            string.IsNullOrEmpty(selectedClinicId))
        {
            bookingMessage = "Alle felter skal udfyldes før booking kan oprettes.";
            bookingAlertClass = "alert alert-danger";
            return;
        }
        try
        {
            var therapistTreatmentTypes = allTherapistTreatmentTypes
                .FirstOrDefault(t => t.Id.ToString() == selectedTreatmentTypeId);

            var request = new CreateBookingRequest
			{
			    CustomerId = Guid.Parse(selectedCustomerId),
				ClinicId = Guid.Parse(selectedClinicId),
                TherapistId = Guid.Parse(selectedTherapistId),

                CampaignDiscountId = string.IsNullOrEmpty(selectedCampaignDiscountId) 
                ? (Guid?)null 
                : Guid.Parse(selectedCampaignDiscountId),
                StartTime = startTime, 
                Lines = therapistTreatmentTypes is not null
                    ? [new BookingLineRequest
                    {
                        TherapistTreatmentTypeId = therapistTreatmentTypes.Id,
                        BasePrice = therapistTreatmentTypes.BasePrice
                    }]
                    : []
			};

            var response = await CreateBookingUseCase.ExecuteAsync(request);
            bookingMessage = $"Booking oprettet!";
            bookingAlertClass = "alert alert-success";

            if (response.Success)
            {
                // Clear form after successful booking
                selectedCustomerId = "";
                selectedClinicId = "";
                selectedTherapistId = "";
                selectedCampaignDiscountId = "";
                startTime = DateTime.Now;
                remainingSlots = null;
                isFullyBooked = false;
                finalResponse = response;
               
            }
            else
            {
                bookingMessage = response.Message; 
				bookingAlertClass = "alert alert-danger";
            }
        }
        catch(Exception ex)
        {
            bookingMessage = $"Fejl: {ex.Message}";
            bookingAlertClass = "alert alert-danger";
        }
    }
}
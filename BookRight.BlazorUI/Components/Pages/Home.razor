@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BookRight.Facade.DTOs.CustomerHistoryDTOs
@using BookRight.Facade.Interfaces.CustomerUseCases
@using BookRight.Facade.Interfaces
@using BookRight.Facade.Interfaces.ClinicsUseCases
@using BookRight.Facade.Interfaces.TreatmentTypesUseCase
@using BookRight.Facade.DTOs.GetAllCustomersDTOs
@using BookRight.Facade.DTOs.GetAllTherapistsDTOs
@using BookRight.Facade.DTOs.CreateTherapistDTOs
@using BookRight.Facade.DTOs.CreateCustomerDTOs
@using BookRight.Facade.DTOs.GetAllClinicsDTOs
@using BookRight.Facade.DTOs.GetAllTreatmentTypesDTOs
@using BookRight.Facade.DTOs.UpdateTherapistDTOs

@inject IGetAllClinicsUseCase GetAllClinicsUseCase
@inject ICreateTherapistUseCase CreateTherapistUseCase
@inject ICreateCustomerUseCase CreateCustomerUseCase
@inject IGetAllTherapistsUseCase GetAllTherapistsUseCase
@inject IGetAllCustomersUseCase GetAllCustomersUseCase
@inject IGetCustomerHistoryUseCase GetCustomerHistoryUseCase
@inject IGetAllTreatmentTypesUseCase GetAllTreatmentTypesUseCase
@inject IUpdateTherapistUseCase UpdateTherapistUseCase

<!--
    Siden benytter Bootstrap klasser til styling
-->

<PageTitle>BookRight Small - Test</PageTitle>

<div class="container mt-4">
	<h1 class="mb-4">BookRight</h1>

	<div class="row">

		<!-- THERAPIST -->
		<article class="col-md-6">
			<section class="card">
				<div class="card-header">
					<h4 class="mb-0">Opret Therapist</h4>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label class="form-label">Fornavn</label>
						<input class="form-control" @bind="therapistFirstName" placeholder="Skriv fornavn her..." />
					</div>
					<div class="mb-3">
						<label class="form-label">Efternavn</label>
						<input class="form-control" @bind="therapistLastName" placeholder="Skriv efternavn her..." />
					</div>
					<div class="mb-3">
						<label class="form-label">Email</label>
						<input class="form-control" @bind="therapistEmail" placeholder="Skriv email her..." />
					</div>

					<select class="form-control" @bind="therapistSpecialization">
						<option value="">Vælg speciale</option>

						@foreach (var specialization in specializations) //DropDown list of all the already created specializations
						{
							<option value="@specialization">
								@specialization
							</option>
						}
					</select>
					<div class="mb-3">
						<label class="form-label">Autorisation</label>

						<select class="form-control" @onchange="OnAuthorizationTypeChanged">
							<option value="">Vælg autorisation</option>

							@foreach (var authorizationType in authorizationTypes)
							{
								<option value="@authorizationType">
									@authorizationType
								</option>
							}
						</select>
						
					</div>
					<div class="mb-3">
						<label class="form-label">Autorisationsnummer</label>

						<input class="form-control"
							   @bind="therapistAuthorizationNumber"
							   placeholder="Skriv autorisationsnummer her..." />

						<small class="text-muted">
							Fortsæt med næste nummer i rækken.
							Seneste registrerede nummer: @latestAuthorizationNumber
						</small>
					</div>
					<div class="mb-3">
					<label class="form-label">Behandlingstyper / Qualifications</label>

						@foreach (var treatmentType in treatmentTypes)
						{
							<div class="form-check">
								<input class="form-check-input"
									   type="checkbox"
									   value="@treatmentType.Id"
									   checked="@selectedTreatmentTypeIds.Contains(treatmentType.Id)"
									   @onchange="e => ToggleTreatmentType(treatmentType.Id, e)" />

								<label class="form-check-label">
									@treatmentType.Name
								</label>
							</div>
						}
					</div>
					<div class="mb-3">
						<label class="form-label">Klinik</label>
						<select class="form-control" @bind="selectedClinicId">
							<option value="@Guid.Empty">Vælg klinik...</option>

							@foreach (var clinic in clinics)
							{
								<option value="@clinic.Id">@clinic.Name</option>
							}
						</select>
					</div>

					<button class="btn btn-primary" @onclick="SaveTherapist">
						@(editingTherapistId.HasValue ? "Gem ændringer" : "Opret")
					</button>

					@if (!string.IsNullOrEmpty(therapistMessage))
					{
						<div class="alert @therapistAlertClass mt-3">@therapistMessage</div>
					}
				</div>
			</section>
		</article>



		<!-- CUSTOMER -->
		<article class="col-md-6">
			<section class="card">
				<div class="card-header">
					<h4 class="mb-0">Opret Kunde</h4>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label class="form-label">Fornavn</label>
						<input class="form-control" @bind="customerFirstName" placeholder="Skriv fornavn her..." />
					</div>
					<div class="mb-3">
						<label class="form-label">Efternavn</label>
						<input class="form-control" @bind="customerLastName" placeholder="Skriv efternavn her..." />
					</div>
					<div class="mb-3">
						<label class="form-label">Email</label>
						<input class="form-control" @bind="customerEmail" placeholder="Skriv email her..." />
					</div>
					<div class="mb-3">
						<label class="form-label">Telefon</label>
						<input class="form-control" @bind="customerPhone" placeholder="Skriv telefon-nummer her..." />
					</div>

					<button class="btn btn-primary" @onclick="CreateCustomer">Opret Kunde</button>

					@if (!string.IsNullOrEmpty(customerMessage))
					{
						<div class="alert @customerAlertClass mt-3">@customerMessage</div>
					}
				</div>


			</section>
		</article>
	</div>

	<!-- THERAPIST TABLE -->
	<div class="row mt-4">
		<article class="col-12">
			<div class="card">
				<div class="card-header">
					<h6 class="mb-0">Se oprettede terap.. hvad hedder det overhovedet på dansk?? Anyway, se dem her</h6>
				</div>
				<section class="card-body">
					@if (!therapists.Any())
					{
						<p class="text-muted">Ingen terapeuter oprettet endnu.</p>
					}
					else
					{
						<table class="table table-striped">
							<thead>
								<tr>
									<th>Navn</th>
									<th>Email</th>
									<th>Speciale</th>
									<th>Autorisation</th>
									<th>Autorisationsnummer</th>
									<th>Klinik</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var therapist in therapists)
								{
									<tr>
										<td>@therapist.FirstName @therapist.LastName</td>
										<td>@therapist.Email</td>
										<td>@therapist.Specialization</td>
										<td>@therapist.AuthorizationType</td>
										<td>@therapist.AuthorizationNumber</td>
										<td>@therapist.ClinicName</td>
										<td>
											<button class="btn btn-sm btn-outline-primary"
													@onclick="() => StartEditTherapist(therapist)">
												Rediger
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</section>
			</div>
		</article>
	</div>

	<!-- CUSTOMER TABLE -->
	<div class="row mt-4">
		<article class="col-12">
			<section class="card">
				<div class="card-header">
					<h4 class="mb-0">Se oprettede kunder her, homie</h4>
				</div>
				<div class="card-body">
					@if (!customers.Any())
					{
						<p class="text-muted">Ingen kunder oprettet endnu.</p>
					}
					else
					{
						<table class="table table-striped">
							<thead>
								<tr>
									<th>Navn</th>
									<th>Email</th>
									<th>Telefon</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var customer in customers)
								{
									<tr>
										<td>@customer.FirstName @customer.LastName</td>
										<td>@customer.Email</td>
										<td>@customer.Phone</td>
										<td><button class="btn btn-sm btn-outline-primary" @onclick="() => selectedCustomerId = customer.Id">Rediger helbredsnoter</button></td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</section>
		</article>
	</div>

    
	@if (selectedCustomerId.HasValue)
	{
		<div class="row mt-4">
			<div class="col-12">
				<CustomerHealthNotesEditor CustomerId="@selectedCustomerId.Value" />
			</div>
		</div>
	}
	<!-- CUSTOMER HISTORY -->
	<div class="row mt-4">
		<article class="col-12">
			<section class="card">
				<div class="card-header">
					<h4 class="mb-0">Kundehistorik og loyalitetsniveau</h4>
				</div>

				<div class="card-body">

					<div class="mb-3">
						<label class="form-label">Søg kunde</label>

						<input class="form-control"
							   @bind="customerHistoryQuery"
							   placeholder="Søg på email, telefon eller navn..." />
					</div>

					<button class="btn btn-primary"
							@onclick="SearchCustomerHistory">
						Søg
					</button>

					@if (!string.IsNullOrEmpty(customerHistoryMessage))
					{
						<div class="alert @customerHistoryAlertClass mt-3">
							@customerHistoryMessage
						</div>
					}

					@if (customerHistories.Any())
					{
						<hr />

						@foreach (var customerHistory in customerHistories)
						{
							<div class="card mt-3">
								<div class="card-body">
									<h5>@customerHistory.FullName</h5>

									<p><strong>Email:</strong> @customerHistory.Email</p>
									<p><strong>Telefon:</strong> @customerHistory.Phone</p>
									<p><strong>Loyalitetsniveau:</strong> @customerHistory.LoyaltyLevel</p>
									<p><strong>Forbrug sidste 12 måneder:</strong> @customerHistory.TotalSpentLast12Months kr.</p>

									<table class="table table-striped mt-4">
										<thead>
											<tr>
												<th>Start</th>
												<th>Slut</th>
												<th>Pris</th>
												<th>Status</th>
											</tr>
										</thead>

										<tbody>
											@foreach (var booking in customerHistory.Bookings)
											{
												<tr>
													<td>@booking.StartTime</td>
													<td>@booking.EndTime</td>
													<td>@booking.TotalPrice kr.</td>
													<td>@booking.Status</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						}
					}
				</div>
			</section>
		</article>
	</div>

</div>

@code {
	// Therapist form fields. Holds the data that you enter into the HTML. HTML in this context just being the fields you type stuff in.
	private string therapistFirstName = "";
	private string therapistLastName = "";
	private string therapistEmail = "";
	private string therapistSpecialization = "";
	private string therapistAuthorizationType = "";
	private string therapistAuthorizationNumber = "";
	private string therapistMessage = "";
	private string therapistAlertClass = "";
	private List<string> specializations = [];
	private string latestAuthorizationNumber = "";
	private List<string> authorizationTypes = [];
	private Guid selectedClinicId = Guid.Empty;
	private Guid? editingTherapistId;

	// Customer form fields.
	private string customerFirstName = "";
	private string customerLastName = "";
	private string customerEmail = "";
	private string customerPhone = "";
	private string customerMessage = "";
	private string customerAlertClass = "";
	private DateOnly customerDateOfBirth = DateOnly.FromDateTime(DateTime.Today);
	private string? customerHealthNotes;
	private Guid? customerPreferredTherapistId;

	// Customer history search fields.
	private string customerHistoryQuery = "";
	private string customerHistoryMessage = "";
	private string customerHistoryAlertClass = "";

	//Therapist form fields
	private List<Guid> selectedTreatmentTypeIds = [];

	// Lister der holder data fra GetAll, til at vise nyligt oprettede entities
	private IReadOnlyList<GetAllTherapistsResponse> therapists = new List<GetAllTherapistsResponse>();
	private IReadOnlyList<GetAllCustomersResponse> customers = new List<GetAllCustomersResponse>();
	private IReadOnlyList<GetAllClinicsResponse> clinics = new List<GetAllClinicsResponse>();
	private IReadOnlyList<CustomerHistoryResponse> customerHistories = new List<CustomerHistoryResponse>();
	private IReadOnlyList<GetAllTreatmentTypesResponse> treatmentTypes = new List<GetAllTreatmentTypesResponse>();

	// HealthNotesEditor
	private Guid? selectedCustomerId;

	protected override async Task OnInitializedAsync()
	{
		await LoadData();
	}

	private async Task LoadData()
	{
		therapists = await GetAllTherapistsUseCase.ExecuteAsync();
		customers = await GetAllCustomersUseCase.ExecuteAsync();
		clinics = await GetAllClinicsUseCase.ExecuteAsync();
		treatmentTypes = await GetAllTreatmentTypesUseCase.ExecuteAsync();
		specializations = therapists //Data already fetched. This is just filtering/UI presentation (NOT BL)
		.Select(t => t.Specialization)
		.Distinct()
		.OrderBy(s => s)
		.ToList();
		authorizationTypes = therapists
		.Select(t => t.AuthorizationType)
		.Where(a => !string.IsNullOrWhiteSpace(a))
		.Distinct()
		.OrderBy(a => a)
		.ToList();
	}

	private async Task CreateTherapist()
	{
		try
		{
			var request = new CreateTherapistRequest(
			therapistFirstName,
			therapistLastName,
			therapistEmail,
			therapistSpecialization,
			therapistAuthorizationType,
			therapistAuthorizationNumber,
			selectedClinicId,
			selectedTreatmentTypeIds

		);

			var response = await CreateTherapistUseCase.ExecuteAsync(request);
			therapistMessage = $"Terapeut oprettet med ID: {response.TherapistId}";
			therapistAlertClass = "alert-success";

			// Nulstil felter efter oprettelse
			ResetTherapistForm();

			await LoadData();
		}
		catch (Exception ex)
		{
			therapistMessage = $"Fejl: {ex.Message}";
			therapistAlertClass = "alert-danger";
		}
	}

	private async Task CreateCustomer()
	{
		try
		{
			var request = new CreateCustomerRequest(
			customerFirstName,
			customerLastName,
			customerEmail,
			customerPhone,
			customerDateOfBirth,
			customerHealthNotes,
			customerPreferredTherapistId
			);

			var response = await CreateCustomerUseCase.ExecuteAsync(request);
			customerMessage = $"Kunde oprettet med ID: {response.customerId}";
			customerAlertClass = "alert-success";

			// Nulstil felter efter oprettelse
			customerFirstName = "";
			customerLastName = "";
			customerPhone = "";

			await LoadData();
		}
		catch (Exception ex)
		{
			customerMessage = $"Fejl: {ex.Message}";
			customerAlertClass = "alert-danger";
		}
	}
	private async Task SearchCustomerHistory()
	{
		try
		{
			customerHistoryMessage = "";
			customerHistoryAlertClass = "";
			customerHistories = new List<CustomerHistoryResponse>(); 

			customerHistories = await GetCustomerHistoryUseCase.ExecuteAsync(customerHistoryQuery); //Kalder UseCase

			customerHistoryQuery = ""; //Clears search field after executed search

			if (!customerHistories.Any())
			{
				customerHistoryMessage = "Ingen kunde fundet.";
				customerHistoryAlertClass = "alert-warning";
			}
		}
		catch (Exception ex) //Fejlbesked, hvis kunde ikke findes
		{
			customerHistoryMessage = $"Fejl: {ex.Message}";
			customerHistoryAlertClass = "alert-danger";
		}

	}

	//Finds the latest authorization number based on selected authorization type
	private void UpdateLatestAuthorizationNumber()
	{
		latestAuthorizationNumber = therapists
			.Where(t => t.AuthorizationType == therapistAuthorizationType)
			.Select(t => t.AuthorizationNumber)
			.LastOrDefault() ?? "Ingen tidligere autorisation fundet";
	}
	private void OnAuthorizationTypeChanged(ChangeEventArgs e) //Uses in-memory LINQ filtering on already loaded therapist data from LoadData(). No database/repository calls are made here, so async/await would be unnecessary fake async
	{
		therapistAuthorizationType = e.Value?.ToString() ?? "";
		UpdateLatestAuthorizationNumber();
	}
	private void ToggleTreatmentType(Guid treatmentTypeId, ChangeEventArgs e)
	{
		var isChecked = (bool?)e.Value == true;

		if (isChecked)
		{
			selectedTreatmentTypeIds.Add(treatmentTypeId);
		}
		else
		{
			selectedTreatmentTypeIds.Remove(treatmentTypeId);
		}

	}
	// Loads therapist data into the form for editing
	private void StartEditTherapist(GetAllTherapistsResponse therapist)
	{
		editingTherapistId = therapist.Id;
		therapistFirstName = therapist.FirstName;
		therapistLastName = therapist.LastName;
		therapistEmail = therapist.Email;
		therapistSpecialization = therapist.Specialization;
		therapistAuthorizationType = therapist.AuthorizationType;
		therapistAuthorizationNumber = therapist.AuthorizationNumber;
		selectedClinicId = therapist.ClinicId;
		selectedTreatmentTypeIds = therapist.TreatmentTypeIds.ToList();
	}
	private void ResetTherapistForm()
	{
		editingTherapistId = null;
		therapistFirstName = "";
		therapistLastName = "";
		therapistEmail = "";
		therapistSpecialization = "";
		therapistAuthorizationType = "";
		therapistAuthorizationNumber = "";
		latestAuthorizationNumber = "";
		selectedClinicId = Guid.Empty;
		selectedTreatmentTypeIds = []; //New list reference needed for check boxes to be cleared
	}

	private async Task UpdateTherapist()
	{
		if (!editingTherapistId.HasValue)
			return;

		var request = new UpdateTherapistRequest(
			editingTherapistId.Value,
			therapistFirstName,
			therapistLastName,
			therapistEmail,
			therapistSpecialization,
			therapistAuthorizationType,
			therapistAuthorizationNumber,
			selectedClinicId,
			selectedTreatmentTypeIds
		);

		var response = await UpdateTherapistUseCase.ExecuteAsync(request);

		therapistMessage = $"Terapeut opdateret med ID: {response.TherapistId}";
		therapistAlertClass = "alert-success";

		editingTherapistId = null;

		ResetTherapistForm();

		await LoadData();
	}

	private async Task SaveTherapist()
	{
		if (editingTherapistId.HasValue)
			await UpdateTherapist();
		else
			await CreateTherapist();
	}

}
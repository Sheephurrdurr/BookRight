@page "/booking-overview" 
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using BookRight.Facade.DTOs.MarkBookingAsNoShowDTOs
@using BookRight.Facade.DTOs.MarkBookingAsArrivedDTOs
@using BookRight.Facade.DTOs.MarkBookingCompletedDTOs

@using BookRight.Facade.DTOs.RestoreBookingFromNoShowDTOs
@using BookRight.Facade.DTOs.GetBookingsForTodayDTOs
@using BookRight.Facade.DTOs.GetAllClinicsDTOs

@using BookRight.Facade.Interfaces.ClinicsUseCases
@using BookRight.Facade.Interfaces.BookingUseCases

@inject IMarkBookingAsNoShowUseCase MarkBookingAsNoShowUseCase
@inject IMarkBookingArrivedUseCase MarkBookingArrivedUseCase
@inject IMarkBookingCompletedUseCase MarkBookingCompletedUseCase
@inject IRestoreBookingFromNoShowUseCase RestoreBookingFromNoShowUseCase
@inject IGetAllClinicsUseCase GetAllClinicsUseCase
@inject IGetBookingsForTodayUseCase GetBookingsForTodayUseCase

<PageTitle>Booking Oversigt</PageTitle>

<div class="card">
    <div class="card-header">
        <h3>Booking Oversig</h3>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Vælg Klinik</label>

            <select class="form-select" @bind="selectedClinicId">
                <option value="">-- Vælg Klinik --</option>

                @foreach (var clinic in clinics)
                {
                    <option value="@clinic.Id">@clinic.Name</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="@alertClass">
                @message
            </div>
        }

        @if (string.IsNullOrEmpty(selectedClinicId))
        {
            <p>Vælg en klinik for, at se dagens planlagte bookinger.</p>
        }
        else if (!FilteredBookings.Any())
        {
            <p>Ingen bookinger i dag...</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tidspunkt</th>
                        <th>Kundes navn</th>
                        <th>Behandlers navn</th>
                        <th>Status</th>
                        <th>Handling</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var booking in FilteredBookings)
                    {
                        <tr>
                            <td>@booking.StartTime.ToString("HH:mm")</td>
                            <td>@booking.CustomerName</td>
                            <td>@booking.TherapistName</td>

                            <td>
                                @if (booking.Status == "NoShow")
                                {
                                    <span class="badge bg-danger">Ikke mødt</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Kommet</span>
                                }
                            </td>
                            <td>
                                @if (booking.Status == "Confirmed")
                                {
                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => RegisterBookingAsNoShow(booking.BookingId)">
                                        Ikke mødt
                                    </button>
                                }
                                else if (booking.Status == "NoShow")
                                {
                                    <button class="btn btn-success btn-sm"
                                            @onclick="() => RestoreBookingFromNoShow(booking.BookingId)">
                                        Gendan
                                    </button>
                                }
								@if (booking.Status == "Confirmed")
								{
									<button class="btn btn-success btn-sm ms-2"
											@onclick="() => RegisterBookingAsArrived(booking.BookingId)">
										Register Arrived
									</button>
								}
								
                                @if (booking.Status == "Arrived")
                                {
                                    <button class="btn btn-success btn-sm ms-2"
                                            @onclick="() => RegisterBookingAsCompleted(booking.BookingId)">
                                        Afslut behandling
                                    </button>
                                }
                                else
                                {
                                    <span>Ingen handling tilgængelig...</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<GetBookingsForTodayResponse> bookings = [];
    private IReadOnlyList<GetAllClinicsResponse> clinics = [];

    private string selectedClinicId = "";
    private string message = "";
    private string alertClass = "";

    private IEnumerable<GetBookingsForTodayResponse> FilteredBookings =>
        bookings
            .Where(b => b.ClinicId.ToString() == selectedClinicId);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() 
    {
         bookings = await GetBookingsForTodayUseCase.ExecuteAsync();
         clinics = await GetAllClinicsUseCase.ExecuteAsync();
     
    }

    // Registers the selected booking as No-show.
    private async Task RegisterBookingAsNoShow(Guid bookingId)
    {
        try
        {
 

            await MarkBookingAsNoShowUseCase.ExecuteAsync(new MarkBookingAsNoShowRequest { BookingId = bookingId });

            message = "Bookingen er registreret som \"Ikke mødt\".";
            alertClass = "alert alert-success";

            await LoadData();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            alertClass = "alert alert-danger";
        }
    }

    // Restores a NoShow booking back to Confirmed.
    private async Task RestoreBookingFromNoShow(Guid bookingId)
    {
        try
        {
            

            await RestoreBookingFromNoShowUseCase.ExecuteAsync( new RestoreBookingFromNoShowRequest(bookingId)); 

            message = "Booking was restored to Confirmed.";
            alertClass = "alert alert-success";

            await LoadData();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            alertClass = "alert alert-danger";
        }
    }

    // Registers the selected booking as Arrived.
    private async Task RegisterBookingAsArrived(Guid bookingId)
    {
        try
        {
            await MarkBookingArrivedUseCase.ExecuteAsync(new MarkBookingArrivedRequest { BookingId = bookingId });
 
            message = "Kunde markeret som ankommet.";
            alertClass = "alert alert-success";

            await LoadData();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            alertClass = "alert alert-danger";
        }
    }


    // Registers the selected booking as Completed.
    private async Task RegisterBookingAsCompleted(Guid bookingId)
    {
        try
        {
            var request = new MarkBookingCompletedRequest
            {
                BookingId = bookingId
            };

            await MarkBookingCompletedUseCase.ExecuteAsync(new MarkBookingCompletedRequest { BookingId = bookingId });

            message = "Booking er registreret som afsluttet.";
            alertClass = "alert alert-success";

            LoadData();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            alertClass = "alert alert-danger";
        }
    }
}

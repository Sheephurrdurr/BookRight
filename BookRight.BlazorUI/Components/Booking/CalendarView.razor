@using BookRight.Facade.DTOs.GetBookingsByWeekDTOs;
@using BookRight.Facade.Interfaces.BookingUseCases;

@inject IGetByWeekUseCase GetByWeekUseCase;

<PageTitle>Kalender</PageTitle>

<div class="container-fluid mt-3">
	<div class="d-flex align-items-center justify-content-between mb-3">
		<h1 class="mb-0">Kalender</h1>
		<div class="d-flex gap-2 align-items-center">
			<button class="btn btn-outline-secondary btn-sm" @onclick="PreviousWeek">Forrige Uge</button>
			<span class="fw-semibold">@WeekStart.ToString("dd. MMM") - @WeekStart.AddDays(6).ToString("dd. MMM yyyy")</span>
			<button class="btn btn-outline-secondary btn-sm" @onclick="NextWeek">Næste Uge</button>
			<button class="btn btn-outline-secondary btn-sm" @onclick="GoToToday">I dag</button>
		</div>
	</div>

	<div class="calendar-shell">
		@*Time*@
		<div class="calendar-time-col">
			<div class="calendar-time-header"></div>
			@for (int h = StartHour; h <= EndHour; h++)
			{
				<div class="calendar-time-label">@h.ToString("00"):00</div>
			}
		</div>

		@*Day*@
		<div class="calendar-days-col">
			<div class="calendar-day-headers">
				@for (int i = 0; i < 7; i++)
				{
					var day = WeekStart.AddDays(i);
					var isToday = day == DateOnly.FromDateTime(DateTime.Today);
					<div class="calendar-day-header @(isToday ? "calendar-today" : "")">
						<div class="calendar-day-name">@DayName(i)</div>
						<div class="cal-day-date @(isToday ? "calendar-today-badge" : "")">@day.ToString("dd/MM")</div>
					</div>
				}
			</div>

			@*Grid*@
			@{
				var totalHeight = $"{TotalHeight}px";
			}
			<div class="calendar-grid-wrapper" style="height: @(TotalHeight)px;">
				@*Create the lines to mark hours*@
				@for (int h = StartHour; h <= EndHour; h++)
				{
					<div class="calendar-hour-line" style="top: @Px(HourToTop(h));"></div>
				}
				<div class="calendar-grid" style="height: @(TotalHeight)px;">
					@*"day-track"*@
					@for (int d = 0; d < 7; d++)
					{
						var day = WeekStart.AddDays(d);
						var dayBookings = bookings
							.Where(b => DateOnly.FromDateTime(b.StartTime) == day)
							.ToList();
						<div class="calendar-day-track @(day == DateOnly.FromDateTime(DateTime.Today) ? "today" : "")"
							 style="height: @(TotalHeight)px;">

							@foreach (var group in dayBookings
							.GroupBy(b => b.StartTime)
							.Select(g => new
							{
								StartTime = g.Key,
								EndTime = g.Max(x => x.EndTime),
								Bookings = g.ToList()
							}))
							{
								var booking = group.Bookings.First();
								var top = TimeToTop(group.StartTime);
								var height = group.Bookings.Count > 1
								? Math.Max(DurationToHeight(group.StartTime, group.EndTime), 60)
								: Math.Max(DurationToHeight(group.StartTime, group.EndTime), 70);
								var color = group.Bookings.Count > 1
								? "#64748B"                  //Grey multiple bookings
								: ClinicToColor(booking.ClinicName);

								<div class="calendar-booking"
									 @onclick="() => SelectBookings(group.Bookings)"
									 style="top: @Px(top); height: @Px(height); background: @color;">

									@if (group.Bookings.Count > 1)
									{
										<div class="calendar-booking-time">
											@group.StartTime.ToString("HH:mm") - @group.EndTime.ToString("HH:mm")
										</div>

										<div class="calendar-booking-title">
											@group.Bookings.Count bookinger
										</div>

										<div class="calendar-booking-clinic">
											Klik for detaljer
										</div>
									}
									else
									{
										<div class="calendar-booking-time">
											@booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")
										</div>

										<div class="calendar-booking-title">
											@booking.TreatmentName
										</div>

										<div>
											@booking.TherapistName
										</div>

										<div class="calendar-booking-clinic">
											@booking.ClinicName
										</div>
									}
								</div>
							}
						</div>
					}
				</div>

			</div>
		</div>
	</div>
</div>
@if (selectedBookings.Any())
{
	<div class="booking-overlay">
		<div class="booking-popup">

			<h3>@selectedBookings.Count booking(er)</h3>

			@foreach (var booking in selectedBookings)
			{
				<div class="booking-detail-card">
				<div class="booking-details-grid">
					<div>
						<strong>Behandling</strong>
						@booking.TreatmentName
					</div>
					<div>
						<strong>Tid</strong>
						@booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")
					</div>

					<div>
						<strong>Status</strong>
						@booking.Status
					</div>

					<div>
						<strong>Terapeut</strong>
						@booking.TherapistName
					</div>

					<div>
						<strong>Klinik</strong>
						@booking.ClinicName
					</div>

					<div>
						<strong>Kunde</strong>
						@booking.CustomerName
					</div>

					<div>
						<strong>Telefon</strong>
						@booking.CustomerPhone
					</div>

					<div>
						<strong>E-mail</strong>
						@booking.CustomerEmail
					</div>

					
				</div>
					<button class="btn btn-outline-primary btn-sm">
						Rediger booking
					</button>

				</div>
				



			}


			<button class="btn btn-secondary"
					@onclick="() => selectedBookings.Clear()">
				Luk
			</button>

		</div>
	</div>
}



@code {
	private const int StartHour = 8;
	private const int EndHour = 18;
	private const int HourHeight = 80;
	private int TotalHeight => (EndHour - StartHour + 1) * HourHeight;

	private DateOnly WeekStart = GetCurrentWeekMonday();
	private IReadOnlyList<GetByWeekResponse> bookings = [];
	private List<GetByWeekResponse> selectedBookings = [];

	protected override async Task OnInitializedAsync()
	{
		await LoadBookings();
	}

	private async Task LoadBookings()
	{
		bookings = await GetByWeekUseCase.ExecuteAsync(WeekStart);
	}

	private async Task PreviousWeek()
	{
		WeekStart = WeekStart.AddDays(-7);
		await LoadBookings();
	}

	private async Task NextWeek()
	{
		WeekStart = WeekStart.AddDays(7);
		await LoadBookings();
	}

	private async Task GoToToday()
	{
		WeekStart = GetCurrentWeekMonday();
		await LoadBookings();
	}

	private double TimeToTop(DateTime time)
	{
		return (time.Hour - StartHour + time.Minute / 60.0) * HourHeight;
	}

	private double DurationToHeight(DateTime start, DateTime end)
	{
		return (end - start).TotalMinutes / 60.0 * HourHeight;
	}

	private double HourToTop(int hour)
	{
		return (hour - StartHour) * HourHeight;
	}

	private static DateOnly GetCurrentWeekMonday()
	{
		var today = DateOnly.FromDateTime(DateTime.Today);
		int diff = (7 + (int)today.DayOfWeek - (int)DayOfWeek.Monday) % 7;
		return today.AddDays(-diff);
	}

	private static string DayName(int dayIndex) => dayIndex switch
	{
		0 => "Mandag",
		1 => "Tirsdag",
		2 => "Onsdag",
		3 => "Torsdag",
		4 => "Fredag",
		5 => "Lørdag",
		6 => "Søndag",
		_ => ""
	};

	private static string Px(double value)
	{
		return $"{value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
	}

	private static string ClinicToColor(string clinicName) => clinicName switch
	{
		"BookRight Vejle Ved Åen" => "#3B82F6", // blå
		"BookRight Egtved" => "#10B981", // grøn
		"BookRight Vejle Bredballe" => "#F59E0B", // orange
		_ => "#64748B" // grå
	};

	private void SelectBookings(IEnumerable<GetByWeekResponse> bookingsToSelect)
	{
		selectedBookings = bookingsToSelect.ToList();
	}
	

}


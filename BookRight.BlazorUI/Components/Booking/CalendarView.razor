@using BookRight.Facade.DTOs.GetBookingsByWeekDTOs
@using BookRight.Facade.Interfaces.BookingUseCases
<!--Injects the use case to follow DI-->
@inject IGetByWeekUseCase GetByWeekUseCase

<PageTitle>Kalender</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="mb-0">Kalender</h1>

        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousDay">Forrige dag</button>
            <span class="fw-semibold">@SelectedDate.ToString("dddd dd. MMMM yyyy")</span>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextDay">Næste dag</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoToToday">I dag</button>
        </div>
    </div>

    <div class="day-calendar-shell">

        <div class="day-time-col">
            <!-- Time column -->
            <div class="day-time-header"></div>

            @for (int h = StartHour; h <= EndHour; h++)
            {
                <div class="day-time-label">@h.ToString("00"):00</div>
            }
        </div>

        <div class="day-calendar-content">
            <!-- Clinic headers -->
            <div class="clinic-header-row">
                @foreach (var clinic in ClinicGroups)
                {
                    <div class="clinic-header"
                         style="border-top-color:@ClinicToColor(clinic.ClinicName);">
                        @clinic.ClinicName
                    </div>
                }
            </div>
            <!-- Therapist headers -->
            <div class="therapist-header-row"> @*Parent who styles the layout with CSS grid*@
                @foreach (var therapist in TherapistColumns) 
                {
                    <div class="therapist-header"> <!--Every therapist-header created in the loop are children. The parent controls the styling-->
                        @therapist.TherapistName
                    </div>
                }
            </div>
            <!-- Calendar grid -->
            <div class="day-grid-wrapper" style="height:@Px(TotalHeight);">
                <!-- Creates horizontal separator lines for each hour in the calendar -->
                @for (int h = StartHour; h <= EndHour; h++)
                {
                    <div class="day-hour-line" style="top:@Px(HourToTop(h));"></div>
                }
                <!-- Creates one grid column per therapist -->
                <div class="day-grid" style="height:@Px(TotalHeight); grid-template-columns: repeat(@TherapistColumns.Count, minmax(160px, 1fr));">
                    <!-- Therapist columns -->
                    @foreach (var therapist in TherapistColumns)
                    {
                        <!--Filters all bookings to include the current therapist and sorts them by start time*-->
                        var therapistBookings = DayBookings
                            .Where(b => b.TherapistId == therapist.TherapistId)
                            .OrderBy(b => b.StartTime)
                            .ToList();


                        <div class="therapist-track" style="height:@Px(TotalHeight);">

                            @foreach (var booking in therapistBookings)
                            {
                                var color = ClinicToColor(booking.ClinicName);
                                var top = TimeToTop(booking.StartTime);
                                <!--Prevents short bookings from becoming too small to read/click by enforcing min. height-->
                                var height = Math.Max(DurationToHeight(booking.StartTime, booking.EndTime), 70);
                                <!-- Booking card -->
                                <!--Inline styles are generated dynamically so each booking is positioned according to its time and duration-->
                                <div class="calendar-booking-card"
                                     @onclick="() => SelectBooking(booking)"
                                     style="
                                    top:@Px(top);
                                    height:@Px(height);
                                    border-left-color:@color;">

                                    <div class="booking-time">
                                        @booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")
                                    </div>

                                    <div class="booking-treatment">
                                        @booking.TreatmentName
                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Booking details popup -->
<!-- Only renders the popup when a booking has been selected -->
@if (selectedBooking is not null)
{
    <div class="booking-overlay">
        <div class="booking-popup">

            <h3>@selectedBooking.TreatmentName</h3>

            <div class="booking-details-grid">
                <div>
                    <strong>Tid</strong>
                    @selectedBooking.StartTime.ToString("HH:mm") - @selectedBooking.EndTime.ToString("HH:mm")
                </div>

                <div>
                    <strong>Status</strong>
                    @selectedBooking.Status
                </div>

                <div>
                    <strong>Terapeut</strong>
                    @selectedBooking.TherapistName
                </div>

                <div>
                    <strong>Klinik</strong>
                    @selectedBooking.ClinicName
                </div>

                <div>
                    <strong>Kunde</strong>
                    @selectedBooking.CustomerName
                </div>

                <div>
                    <strong>Telefon</strong>
                    @selectedBooking.CustomerPhone
                </div>

                <div>
                    <strong>E-mail</strong>
                    @selectedBooking.CustomerEmail
                </div>

                <div>
                    <strong>Booking ID</strong>
                    @selectedBooking.BookingId
                </div>
            </div>

            @* Btn for edit, but we don't have an EditBookingUseCase*@
            <button class="btn btn-outline-primary btn-sm me-2">
                Rediger booking
            </button>

            <button class="btn btn-secondary btn-sm"
                    @onclick="() => selectedBooking = null">
                <!--Closes the popup by removing the selected booking reference-->
                Luk
            </button>

        </div>
    </div>
}

@code {

    // Calendar configuration
    private const int StartHour = 8;
    private const int EndHour = 18;
    private const int HourHeight = 80;

    // Total height of the calendar grid based on configured opening hours
    private int TotalHeight => (EndHour - StartHour + 1) * HourHeight;

    // The currently displayed day
    private DateOnly SelectedDate = DateOnly.FromDateTime(DateTime.Today);

    // Weekly bookings loaded from the use case
    private IReadOnlyList<GetByWeekResponse> bookings = [];

    // Selected booking shown in the popup
    private GetByWeekResponse? selectedBooking;

    // Filters weekly bookings down to the currently selected day
    private List<GetByWeekResponse> DayBookings =>
        bookings
            .Where(b => DateOnly.FromDateTime(b.StartTime) == SelectedDate)
            .ToList();

    // Groups therapists by clinic to create the column layout
    private List<ClinicGroupView> ClinicGroups =>
        DayBookings
            .GroupBy(b => b.ClinicName)
            .Select(g => new ClinicGroupView
            {
                ClinicName = g.Key,

                // Prevent duplicate therapist columns
                Therapists = g
                    .GroupBy(x => new { x.TherapistId, x.TherapistName })
                    .Select(t => new TherapistColumnView
                    {
                        TherapistId = t.Key.TherapistId,
                        TherapistName = t.Key.TherapistName,
                        ClinicName = g.Key
                    })
                    .OrderBy(t => t.TherapistName)
                    .ToList()
            })

            // Ensures clinics are always displayed in the same order
            .OrderBy(g => ClinicSortOrder(g.ClinicName))
            .ToList();

    // Flattens clinic groups into therapist columns used by the grid
    private List<TherapistColumnView> TherapistColumns =>
        ClinicGroups
            .SelectMany(g => g.Therapists)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    // Loads all bookings for the week containing the selected day
    private async Task LoadBookings()
    {
        bookings = await GetByWeekUseCase.ExecuteAsync(GetCurrentWeekMonday(SelectedDate));
    }

    private async Task PreviousDay()
    {
        SelectedDate = SelectedDate.AddDays(-1);
        await LoadBookings();
    }

    private async Task NextDay()
    {
        SelectedDate = SelectedDate.AddDays(1);
        await LoadBookings();
    }

    private async Task GoToToday()
    {
        SelectedDate = DateOnly.FromDateTime(DateTime.Today);
        await LoadBookings();
    }

    // Opens booking details popup
    private void SelectBooking(GetByWeekResponse booking)
    {
        selectedBooking = booking;
    }

    // Converts booking start time into a vertical pixel position
    private double TimeToTop(DateTime time)
    {
        return (time.Hour - StartHour + time.Minute / 60.0) * HourHeight;
    }

    // Converts booking duration into the visual card height
    private double DurationToHeight(DateTime start, DateTime end)
    {
        return (end - start).TotalMinutes / 60.0 * HourHeight;
    }

    // Calculates the position of hour separator lines
    private double HourToTop(int hour)
    {
        return (hour - StartHour) * HourHeight;
    }

    // Retrieves Monday of the week containing the selected day
    private static DateOnly GetCurrentWeekMonday(DateOnly date)
    {
        int diff = (7 + (int)date.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        return date.AddDays(-diff);
    }

    /*Converts numeric values into CSS pixel values.
    Inline styles require values such as "80px" instead of plain numbers.
    InvariantCulture ensures decimal values use '.' which CSS expects*/
    private static string Px(double value)
    {
        return $"{value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
    }

    // Assigns a consistent color to each clinic
    private static string ClinicToColor(string clinicName) => clinicName switch
    {
        "BookRight Vejle Ved Åen" => "#3B82F6",
        "BookRight Egtved" => "#10B981",
        "BookRight Vejle Bredballe" => "#F59E0B",
        _ => "#64748B"
    };

    // View model used for grouping therapists by clinic
    private sealed class ClinicGroupView
    {
        public string ClinicName { get; set; } = "";
        public List<TherapistColumnView> Therapists { get; set; } = [];
    }

    // Represents a therapist column in the calendar
    private sealed class TherapistColumnView
    {
        public Guid TherapistId { get; set; }
        public string TherapistName { get; set; } = "";
        public string ClinicName { get; set; } = "";
    }

    // Controls clinic display order in the calendar
    private static int ClinicSortOrder(string clinicName) => clinicName switch
    {
        "BookRight Egtved" => 1,
        "BookRight Vejle Bredballe" => 2,
        "BookRight Vejle Ved Åen" => 3,
        _ => 99
    };
}
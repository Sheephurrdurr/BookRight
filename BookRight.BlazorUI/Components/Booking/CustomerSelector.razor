@using BookRight.Facade.DTOs.GetAllCustomersDTOs


<div class="mt-4">
    <label class="form-label fw-semibold">Kunde</label>
    <select class="form-select" value="@SelectedCustomerId" @onchange="OnChanged">
        <option value="">-- Vælg Kunde --</option>
        @foreach (var customer in Customers)
        {
            <option value="@customer.Id">@customer.FirstName @customer.LastName</option>
        }

    </select>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<GetAllCustomersResponse> Customers { get; set; } = [];

    [Parameter]
    public string SelectedCustomerId { get; set; } = "";

    [Parameter]
    public EventCallback<string> SelectedCustomerIdChanged { get; set; }

    private async Task OnChanged(ChangeEventArgs e)
    {
        await SelectedCustomerIdChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }
}

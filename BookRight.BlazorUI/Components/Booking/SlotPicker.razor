<div class="mt-4">
    <label class="form-label fw-semibold">Dato</label>
    <input type="date"
           class="form-control"
           value="@StartTime.ToString("yyyy-MM-dd")"
           @onchange="OnDateChanged" />
</div>

<div class="mt-3">
    <label class="form-label fw-semibold">Starttid</label>
    <select class="form-select"
            value="@StartTime.ToString("HH:mm")"
            @onchange="OnDropdownTimeChanged">
        @foreach (var time in TimeOptions)
        {
            <option value="@time">@time</option>
        }
    </select>
</div>

@code {
    [Parameter, EditorRequired]
    public DateTime StartTime { get; set; } = DateTime.Now;

    [Parameter]
    public int? RemainingSlots { get; set; }

    [Parameter]
    public bool IsFullyBooked { get; set; }

    [Parameter]
    public EventCallback<DateTime> OnSlotChanged { get; set; }

    [Parameter]
    public EventCallback<DateTime> StartTimeChanged { get; set; }

    private List<string> TimeOptions => Enumerable
        .Range(8 * 4, (18 - 8) * 4 + 1)
        .Select(i => TimeOnly.MinValue.AddMinutes(i * 15).ToString("HH:mm"))
        .ToList();

    // Dato-feltet opdaterer kun datoen og bevarer det valgte tidspunkt.
    public async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            var newDateTime = date.Date
                .AddHours(StartTime.Hour)
                .AddMinutes(StartTime.Minute);

            await StartTimeChanged.InvokeAsync(newDateTime);
            await OnSlotChanged.InvokeAsync(newDateTime);
        }
    }

    // Tid-dropdown opdaterer kun tidspunktet og bevarer den valgte dato.
    public async Task OnDropdownTimeChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var time))
        {
            var newDateTime = StartTime.Date
                .AddHours(time.Hour)
                .AddMinutes(time.Minute);

            await StartTimeChanged.InvokeAsync(newDateTime);
            await OnSlotChanged.InvokeAsync(newDateTime);
        }
    }
}